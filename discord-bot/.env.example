# Caedral Discord Bot — self-hosted environment
#
# Copy to discord-bot/.env before: docker compose -f discord-bot/docker-compose.yml up -d --build
#
# Required: Caedral API key from https://caedral.com/dashboard/api-keys
# Docs: https://caedral.com/docs/discord-bot

# ─── Caedral platform ────────────────────────────────────────────────

# Self-hosted registration + AI usage billing (cd_live_…)
# Gateway is always https://api.caedral.com — not configurable on self-hosted.
CAEDRAL_API_KEY=

# Ticket AI model — Caedral chat model id (billed from your prepaid balance)
# caedral-base | caedral-titan | caedral-olympus | caedral-primordial
CAEDRAL_ASSISTANT_MODEL=caedral-base

# Set to 0 to skip auto-ingest of bundled FAQ on first boot (table must exist)
# KNOWLEDGE_AUTO_INGEST=1

# Optional: override system prompt (dashboard can also set this remotely)
# CAEDRAL_BOT_SYSTEM_PROMPT=

# Local dev only — skip platform registration (no heartbeat, no AI billing auth)
# CAEDRAL_BOT_ALLOW_UNREGISTERED=1

# Internal Caedral deployment only — instance UUID (do not set on self-hosted)
# CAEDRAL_BOT_INSTANCE_ID=

# ─── Discord ─────────────────────────────────────────────────────────

DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
# DISCORD_BOT_APPLICATION_ID=

DISCORD_GUILD_ID=
OWNER_DISCORD_ID=

DISCORD_ANNOUNCEMENTS_CHANNEL_ID=
DISCORD_UPDATES_CHANNEL_ID=
DISCORD_SUPPORT_CHANNEL_ID=
DISCORD_TICKET_CATEGORY_ID=
DISCORD_TICKET_LOG_CHANNEL_ID=

# Optional: dedicated changelog log channel (defaults to ticket log channel)
# DISCORD_CHANGELOG_LOG_CHANNEL_ID=
# DISCORD_BRAND_ICON_URL=

# ─── Bot database (docker-compose sets DATABASE_URL automatically) ───

POSTGRES_USER=caedral_bot
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=caedral_bot

# Override only if not using bundled postgres service:
# DATABASE_URL=postgresql://caedral_bot:change-me@postgres:5432/caedral_bot

# ─── Branding / links ────────────────────────────────────────────────

NEXT_PUBLIC_SITE_URL=https://caedral.com

# ─── Optional integrations ───────────────────────────────────────────

# DISCORD_BOT_INTERNAL_PORT=5010
# DISCORD_BOT_INTERNAL_HOST=0.0.0.0
# DISCORD_BOT_INTERNAL_SECRET=

# Caedral platform DB features (user lookup) — not for self-hosted postgres
# CAEDRAL_PLATFORM_USER_LOOKUP=1

# CHANGELOG_API_SECRET=
# BOT_HOSTNAME=my-vps
# BOT_VERSION=1.0.0
